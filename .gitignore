# Secrets: the Token Factory key lives in .env and must never be committed
.env

# Local virtual environment (recreate with: python3.12 -m venv .venv-spine)
.venv-spine/

# Saved model replies and generated charts (rebuilt by running the scripts)
results/

# Calibration output and scratch files used by the Makefile
scratch/

# Local tooling state: Claude Code settings and Superpowers workspaces
.claude/
.superpowers/

# macOS metadata
.DS_Store

# Python caches
__pycache__/
*.pyc

# Node.js dependencies and build artifacts
node_modules/
dist/

# Frontend: installed packages and the Vite build output (rebuilt by npm run build)
node_modules/
dist/

# Local Netlify folder
.netlify
build/
*.egg-info/
